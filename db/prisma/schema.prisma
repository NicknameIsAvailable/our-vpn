generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id             String   @id @default(uuid())
  name           String
  country        String
  city           String?
  ip             String
  coordinates    String
  user           String
  url            String
  host           String
  port           Int
  password       String
  configs        Config[] @relation("LocationConfig")
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  nickname String   @unique
  password String
}

model Config {
  id          String   @id @default(uuid())
  name        String
  isTrial     Boolean @default(false)
  userId      String
  username    String
  price       Int
  promoCodeId String?
  promoCode   PromoCode? @relation("PromoCodeConfig", fields: [ promoCodeId ], references: [ id ])
  locationId  String
  location    Location @relation("LocationConfig", fields: [locationId], references: [id])
  config      Json
  vlessUrl    String
  @@map("VlessConfig")
}

model PromoCode {
  id              String @id @default(uuid())
  code            String @unique
  name            String
  description     String
  discountPercent Int
  configs         Config[] @relation("PromoCodeConfig")
}
