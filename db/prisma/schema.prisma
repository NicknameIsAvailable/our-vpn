generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(uuid())
  label       String   @default("")
  comment     String   @default("")
  name        String
  country     String
  city        String?
  ip          String
  coordinates String
  user        String
  url         String
  host        String
  port        Int
  password    String
  configs     Config[] @relation("LocationConfig")
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
}

model Invoice {
  id               String   @id
  amount           Int
  configId         String?
  Config           Config[] @relation("InvoiceConfig")
  status           String
  paid             Boolean
  confirmation_url String
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt
}

model TgUser {
  id       BigInt   @id @unique
  username String   @default("anon")
  configs  Config[]

  referringProgress UserProgress? @relation("Referrals", fields: [userProgressId], references: [id])
  userProgressId    String?       @unique @map("user_progress_id")

  userProgress UserProgress? @relation("UserProgressOwner")

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  usedPromoCodes  PromoCode[] @relation("UsedPromoCodes") // Промокоды, которые пользователь уже использовал
  savedPromoCodes PromoCode[] @relation("SavedPromoCodes") // Промокоды, которые пользователь сохранил

  ownedPromoCode PromoCode? @relation("OwnedPromoCode")
}

model UserProgress {
  id              String @id @default(uuid())
  currentLevelId  String
  currentLevel    Level  @relation(fields: [currentLevelId], references: [id])
  accumulatedDays Int    @default(0)

  tgUserId  BigInt   @unique
  tgUser    TgUser   @relation("UserProgressOwner", fields: [tgUserId], references: [id])
  referrals TgUser[] @relation("Referrals")

  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  promoCodes PromoCode[] @relation("ReferrerProgressPromocode")
}

model Level {
  id                      String         @id @default(uuid())
  label                   String
  usersCount              Int
  comment                 String
  instantBonusDays        Int            @default(0)
  constantBonusDays       Int            @default(0)
  constantBonusDiscount   Int            @default(0)
  referralDiscountPercent Int            @default(0)
  created_at              DateTime       @default(now())
  updated_at              DateTime       @default(now()) @updatedAt
  UserProgress            UserProgress[]
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  nickname   String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Config {
  id          String     @id @default(uuid())
  name        String
  isTrial     Boolean    @default(false)
  invoiceId   String?
  invoice     Invoice?   @relation("InvoiceConfig", fields: [invoiceId], references: [id])
  promoCodeId String?
  promoCode   PromoCode? @relation("PromoCodeConfig", fields: [promoCodeId], references: [id])
  locationId  String
  location    Location   @relation("LocationConfig", fields: [locationId], references: [id])
  config      Json
  vlessUrl    String
  created_at  DateTime   @default(now())
  updated_at  DateTime   @default(now()) @updatedAt
  tgUser      TgUser?    @relation(fields: [tgUserId], references: [id])
  tgUserId    BigInt?
  expiryTime  BigInt     @default(0)

  @@map("VlessConfig")
}

enum PromoCodeType {
  REFERRAL
  COMMERCIAL
}

model PromoCode {
  id                      String        @id @default(uuid())
  code                    String        @unique
  type                    PromoCodeType @default(REFERRAL)
  url                     String
  name                    String
  description             String
  usesCount               Int
  bonusDays               Int           @default(0)
  discountPercent         Int           @default(0)
  referralDiscountPercent Int           @default(0)
  referralBonusDays       Int           @default(0)
  configs                 Config[]      @relation("PromoCodeConfig")

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  users        TgUser[] @relation("UsedPromoCodes") // Те, кто использовал этот промокод
  savedByUsers TgUser[] @relation("SavedPromoCodes") // Те, кто сохранил промокод
  owner        TgUser?  @relation("OwnedPromoCode", fields: [ownerId], references: [id])
  ownerId      BigInt?  @unique

  referrerProgress   UserProgress? @relation("ReferrerProgressPromocode", fields: [referrerProgressId], references: [id])
  referrerProgressId String?
}
