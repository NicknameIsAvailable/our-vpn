generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id             String   @id @default(uuid())
  name           String
  country        String
  city           String?
  ip             String
  coordinates    String
  user           String
  url            String
  host           String
  port           Int
  password       String
  configs        Config[] @relation("LocationConfig")
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  nickname String   @unique
  password String
}

model Config {
  id        String   @id @default(uuid())
  name      String
  userId    String
  locationId String
  location  Location @relation("LocationConfig", fields: [locationId], references: [id]) // Связь с моделью Location
  config    Json
  vlessUrl  String
  @@map("VlessConfig")
}
